---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Stitch from '../components/Stitch.astro';
import { NAV, SITE, href, instagramUrl } from '../lib/site.ts';

interface Props {
  title?: string;
  description?: string;
  /** The home page opens with the full masthead; inner pages get a running head. */
  masthead?: boolean;
}

const { title, description = SITE.description, masthead = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const isCurrent = (path: string) => {
  const target = href(path);
  return path === '' ? Astro.url.pathname === target : Astro.url.pathname.startsWith(target);
};

// The same curve drawn twice: behind the letters, and in front of them in
// dashes, so the thread seems to pass over and under the strokes like the
// one running through the logo's monogram. It ends level, to run straight
// into the knot.
const THREAD_PATH = 'M0 150 C 90 150, 130 108, 220 110 S 400 136, 500 122 S 690 96, 790 112 S 920 100, 1000 96';

// One knot for the whole publication, drawn as a single stroke so it can
// be traced in one motion: a figure eight whose two lobes only meet where
// they cross, like a ribbon bow, ending in a loose tail. It ties the
// masthead's thread and closes the footer. The thread enters at the left
// edge, at entryY. The CSS reads the box through custom properties, so a
// new drawing needs no recalculated numbers in the styles.
const KNOT = {
  width: 115,
  height: 87,
  entryY: 46.2,
  path: 'M0 46.2 C 4 46.2, 16.7 46.7, 24 46.2 C 31.3 45.7, 38.5 44.8, 44 43.2 C 49.5 41.6, 53 39.8, 57.2 36.5 C 61.4 33.2, 67 28, 69 23.5 C 71 19, 70.8 12.9, 69.1 9.5 C 67.4 6.1, 62.1 3, 58.6 3 C 55.1 3, 49.9 5.7, 48.1 9.3 C 46.3 12.9, 46.8 19, 47.8 24.4 C 48.8 29.8, 52 36.1, 54.1 41.9 C 56.2 47.7, 58.9 53.8, 60.3 59.3 C 61.7 64.8, 63.8 70.8, 62.3 74.8 C 60.8 78.8, 55 83.1, 51.4 83.4 C 47.8 83.8, 42.3 80.3, 40.9 76.9 C 39.5 73.6, 40.9 68.1, 43.3 63.3 C 45.7 58.5, 50.6 51.8, 55.1 48.3 C 59.6 44.8, 64.5 42.9, 70 42.2 C 75.5 41.5, 82.7 42.2, 88 44.2 C 93.3 46.2, 98 50.2, 102 54.2 C 106 58.2, 110.3 65.9, 112 68.2',
};
const knotVars = [
  `--knot-units: ${KNOT.width}`,
  `--knot-aspect: ${KNOT.width} / ${KNOT.height}`,
  `--knot-entry: ${KNOT.entryY / KNOT.width}`,
].join('; ');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <Font cssVariable="--font-piazzolla" preload />
    <Font cssVariable="--font-archivo" preload />
  </head>
  <body>
    <!--
      THESIS: Entre Laços as a literary magazine held together by its own red thread: the logo's "laço" runs through the masthead, sections join with a running stitch, the page ends in a knot. Refuses the hero-with-button landing and the card grid.
      OWN-WORLD: wine bookcloth fields, rose only as highlighter, light-rose endpaper, red thread; Piazzolla (display and reading) with Archivo for bylines; books as objects with real shadows; no cards, no pills, editorial links.
      STORY: the reader meets a publication, opens its newest review, scans the table of contents, reads a highlighted passage, meets the students who write.
      FIRST VIEWPORT: masthead wordmark at display scale with the thread woven through, description and nav; the newest review's book large on a wine field below, title and byline beside it; "Ler a resenha" link.
      FORM: independent literary magazine (brief-pinned, beats the roll; own list #1), raised by coptic exposed binding (structure as the only ornament) and patent sheet (one ink, one meaning). Seed 823439ef.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <header class:list={['site-header', { masthead }]}>
      <div class="container header-inner">
        {
          masthead ? (
            <>
              <h1 class="wordmark-block">
                <span class="wordmark">
                  <svg class="thread thread-under" viewBox="0 0 1000 200" preserveAspectRatio="none" aria-hidden="true">
                    <path d={THREAD_PATH} pathLength="100" />
                  </svg>
                  {SITE.name}
                  <svg class="thread thread-over" viewBox="0 0 1000 200" preserveAspectRatio="none" aria-hidden="true">
                    <path d={THREAD_PATH} pathLength="100" />
                  </svg>
                  <svg
                    class="thread-knot"
                    viewBox={`0 0 ${KNOT.width} ${KNOT.height}`}
                    style={knotVars}
                    aria-hidden="true"
                  >
                    <path d={KNOT.path} pathLength="1" />
                  </svg>
                </span>
              </h1>
              <p class="masthead-line">{SITE.description}</p>
            </>
          ) : (
            <a class="brand" href={href('')}>
              {SITE.name}
            </a>
          )
        }
        <nav aria-label="Principal" class="site-nav">
          <ul>
            {
              NAV.map((item) => {
                const current = isCurrent(item.path);
                return (
                  <li>
                    <a href={href(item.path)} aria-current={current ? 'page' : undefined}>
                      {item.label}
                      {current && <span class="nav-mark" aria-hidden="true" />}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
      </div>
      <Stitch />
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="knot-line" style={knotVars} aria-hidden="true">
        <span class="knot-thread"></span>
        <svg class="knot" viewBox={`0 0 ${KNOT.width} ${KNOT.height}`} aria-hidden="true">
          <path d={KNOT.path} />
        </svg>
      </div>
      <div class="container footer-grid">
        <div class="colophon">
          <h2 class="footer-title">Expediente</h2>
          <p class="footer-statement">
            {SITE.name} é uma publicação independente de estudantes de Psicologia da {SITE.institution}.
          </p>
          <p class="footer-note">
            Conteúdo produzido por estudantes de Psicologia. Este site não oferece atendimento
            psicológico.
          </p>
        </div>
        <nav aria-label="Rodapé" class="footer-nav">
          <ul>
            {
              NAV.filter((item) => item.path !== '').map((item) => (
                <li>
                  <a href={href(item.path)}>{item.label}</a>
                </li>
              ))
            }
            <li>
              <a href={instagramUrl(SITE.instagram)} rel="noopener noreferrer" target="_blank">
                Instagram @{SITE.instagram}
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    padding: 0.5rem 1rem;
    background: var(--color-wine);
    color: #fff;
    font-family: var(--font-sans);
    z-index: 10;
  }
  .skip-link:focus {
    top: 1rem;
  }

  /* ---- Running head (inner pages) ---- */
  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 2rem;
    padding-block: 0.75rem;
  }
  .brand {
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-wine);
    text-decoration: none;
  }
  .brand:hover {
    color: var(--color-wine-deep);
  }

  /* ---- Masthead (home) ---- */
  .masthead .header-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    padding-block: clamp(1.25rem, 3.5vw, 2.5rem) 0.25rem;
  }
  .wordmark-block {
    margin: 0;
    /* The word plus its knot measure about 5.9em: sized so they always fit
       the column, and a phone never scrolls sideways. */
    font-size: clamp(3rem, calc((100vw - 2 * var(--gutter)) / 5.9), 9.75rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.035em;
    color: var(--color-ink);
  }
  .wordmark {
    position: relative;
    display: inline-block;
    isolation: isolate;
    padding-bottom: 0.08em;
    /* Room for the knot (it starts 4% past the word and is 0.95em wide),
       so it never runs into the description. */
    margin-right: 1.15em;
  }
  .thread {
    position: absolute;
    left: -5%;
    top: 0;
    width: 109%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .thread path,
  .thread-knot path {
    fill: none;
    stroke: var(--color-thread);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* The thread's box is stretched (preserveAspectRatio none), so its stroke
     is kept in screen space. */
  .thread path {
    stroke-width: 0.02em;
    vector-effect: non-scaling-stroke;
  }
  /* The knot scales uniformly instead, and must: its draw-on dash is
     measured in its own units. 0.95em spans --knot-units, so this width
     equals the thread's 0.02em at any size. */
  .thread-knot path {
    stroke-width: calc(var(--knot-units) * 0.02px / 0.95);
  }
  /* The footer's knot, tied where the masthead's thread ends. */
  .thread-knot {
    position: absolute;
    /* The thread's drawing ends at -5% + 109% of the word, at y = 96 of
       200 (48%); the knot's entry sits on that point. */
    left: 104%;
    top: calc(48% - 0.95em * var(--knot-entry));
    width: 0.95em;
    aspect-ratio: var(--knot-aspect);
    overflow: visible;
    pointer-events: none;
  }
  .thread-under {
    z-index: -1;
  }
  /* Dashes of the front copy are where the thread crosses over the strokes. */
  .thread-over path {
    stroke-dasharray: 7 6 9 5 6 7 10 6 8 5;
  }
  .masthead-line {
    max-width: 26rem;
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
  @media (min-width: 56rem) {
    .masthead .header-inner {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: end;
      /* The knot already separates the name from the description. */
      column-gap: clamp(1.25rem, 2.5vw, 2.25rem);
    }
    .masthead-line {
      margin-bottom: 1.1em;
    }
    .masthead .site-nav {
      grid-column: 1 / -1;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .thread {
      animation: pull-thread 1.1s var(--ease-out) 0.15s backwards;
    }
    /* Once the thread is through the name, it ties itself in one stroke:
       it starts as slowly as the thread arrives, speeds through the lobes
       and settles at the tail. */
    .thread-knot path {
      stroke-dasharray: 1;
      animation: tie-knot 1.1s cubic-bezier(0.45, 0, 0.25, 1) 1s backwards;
    }
  }
  @keyframes pull-thread {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  /* Hidden until its own turn: a dash pattern alone leaves round-cap
     specks where the dashes meet the path's ends. */
  @keyframes tie-knot {
    from {
      stroke-dashoffset: 1;
      opacity: 0;
    }
    1% {
      opacity: 1;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  /* ---- Navigation ---- */
  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(1rem, 3vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav a {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-ink);
    text-decoration: none;
  }
  /* Hover draws a hairline from the left. */
  .site-nav a::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0.45rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
  }
  /* The current page is marked as a reader marks a book: highlighter. */
  .nav-mark {
    position: absolute;
    z-index: -1;
    inset-inline: -0.2em;
    top: calc(50% - 0.12em);
    height: 0.55em;
    border-radius: var(--radius-book);
    background: var(--color-rose);
    mix-blend-mode: multiply;
  }
  @media (hover: hover) {
    .site-nav a:hover {
      color: var(--color-wine);
    }
    .site-nav a:not([aria-current]):hover::after {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .site-nav a::after {
      transition: transform var(--duration-base) var(--ease-out);
    }
    .nav-mark {
      view-transition-name: nav-mark;
    }
  }

  /* ---- Expediente ---- */
  .site-footer {
    margin-top: clamp(4rem, 10vw, 7rem);
    padding-bottom: 3rem;
    background: var(--color-wine);
    color: var(--color-on-wine);
  }
  /* The thread that ran through the masthead ends here, tied. */
  /* Thread from the left edge of the screen, knot at the content's right
     edge (the right padding equals the container's side margin). */
  .knot-line {
    display: flex;
    align-items: flex-start;
    padding-top: 1.5rem;
    padding-right: calc((100% - min(100% - 2 * var(--gutter), var(--content-width))) / 2);
  }
  /* Sits on the knot's entry line. */
  .knot-thread {
    flex: 1;
    height: 2.5px;
    margin-top: calc(7rem * var(--knot-entry) - 1.25px);
    background: var(--color-thread);
  }
  .knot {
    flex: none;
    width: 7rem;
    aspect-ratio: var(--knot-aspect);
    overflow: visible;
  }
  .knot path {
    fill: none;
    stroke: var(--color-thread);
    stroke-width: 2.5px;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .footer-grid {
    display: grid;
    gap: 2.5rem 4rem;
    padding-top: 2rem;
  }
  @media (min-width: 48rem) {
    .footer-grid {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }
  .footer-title {
    margin: 0 0 0.75rem;
    font-size: 1.75rem;
  }
  .footer-statement {
    max-width: 30rem;
    margin: 0 0 1.25rem;
    font-size: clamp(1.125rem, 2vw, 1.3125rem);
    line-height: 1.4;
  }
  .footer-note {
    max-width: 30rem;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-on-wine-muted);
  }
  .footer-nav ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-sans);
    color: var(--color-on-wine);
  }
  .footer-nav a:hover {
    color: #fff;
  }
  /* The global wine ring disappears on the wine footer. */
  .site-footer a:focus-visible {
    outline-color: var(--color-rose);
  }
</style>
