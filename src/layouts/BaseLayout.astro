---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Stitch from '../components/Stitch.astro';
import { STORAGE_KEY, TEXT_SCALES } from '../lib/reading-settings.ts';
import { NAV, SITE, href, instagramUrl } from '../lib/site.ts';

interface Props {
  title?: string;
  description?: string;
  /** The home page opens with the full masthead; inner pages get a running head. */
  masthead?: boolean;
}

const { title, description = SITE.description, masthead = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const isCurrent = (path: string) => {
  const target = href(path);
  return path === '' ? Astro.url.pathname === target : Astro.url.pathname.startsWith(target);
};

// The same curve drawn twice: behind the letters, and in front of them in
// dashes, so the thread seems to pass over and under the strokes like the
// one running through the logo's monogram. It ends level, to run straight
// into the knot.
const THREAD_PATH = 'M0 150 C 90 150, 130 108, 220 110 S 400 136, 500 122 S 690 96, 790 112 S 920 100, 1000 96';

// One knot for the whole publication, drawn as a single stroke so it can
// be traced in one motion: a figure eight whose two lobes only meet where
// they cross, like a ribbon bow, ending in a loose tail. It ties the
// masthead's thread and closes the footer. The thread enters at the left
// edge, at entryY. The CSS reads the box through custom properties, so a
// new drawing needs no recalculated numbers in the styles.
const KNOT = {
  width: 115,
  height: 87,
  entryY: 46.2,
  path: 'M0 46.2 C 4 46.2, 16.7 46.7, 24 46.2 C 31.3 45.7, 38.5 44.8, 44 43.2 C 49.5 41.6, 53 39.8, 57.2 36.5 C 61.4 33.2, 67 28, 69 23.5 C 71 19, 70.8 12.9, 69.1 9.5 C 67.4 6.1, 62.1 3, 58.6 3 C 55.1 3, 49.9 5.7, 48.1 9.3 C 46.3 12.9, 46.8 19, 47.8 24.4 C 48.8 29.8, 52 36.1, 54.1 41.9 C 56.2 47.7, 58.9 53.8, 60.3 59.3 C 61.7 64.8, 63.8 70.8, 62.3 74.8 C 60.8 78.8, 55 83.1, 51.4 83.4 C 47.8 83.8, 42.3 80.3, 40.9 76.9 C 39.5 73.6, 40.9 68.1, 43.3 63.3 C 45.7 58.5, 50.6 51.8, 55.1 48.3 C 59.6 44.8, 64.5 42.9, 70 42.2 C 75.5 41.5, 82.7 42.2, 88 44.2 C 93.3 46.2, 98 50.2, 102 54.2 C 106 58.2, 110.3 65.9, 112 68.2',
};
const knotVars = [
  `--knot-units: ${KNOT.width}`,
  `--knot-aspect: ${KNOT.width} / ${KNOT.height}`,
  `--knot-entry: ${KNOT.entryY / KNOT.width}`,
].join('; ');
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* The group's logo: round with transparent corners for tabs; square and
        opaque for iOS, which rounds the corners itself. */}
    <link rel="icon" type="image/png" sizes="96x96" href={href('favicon.png')} />
    <link rel="apple-touch-icon" href={href('apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    {/* Preload the roman only: the italic sets book titles and can arrive later. */}
    <Font cssVariable="--font-piazzolla" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-archivo" preload />
    {/* The reader's saved settings, applied before the first paint so the page
        never flashes at the default size or contrast. Mirrors parseSettings
        (src/lib/reading-settings.ts) at its simplest; the panel script below
        does the full validation. */}
    <script is:inline define:vars={{ storageKey: STORAGE_KEY, scales: TEXT_SCALES }}>
      const root = document.documentElement;
      let saved = {};
      try {
        saved = JSON.parse(localStorage.getItem(storageKey) || '{}') || {};
      } catch {
        // Storage blocked (private mode, disabled) or unreadable: the page
        // keeps its defaults, which is the right fallback.
      }
      const multiplier = scales[saved.scale];
      if (typeof multiplier === 'number' && multiplier !== 1) {
        root.style.setProperty('--text-scale', String(multiplier));
      }
      if (saved.contrast === true || matchMedia('(prefers-contrast: more)').matches) root.dataset.contrast = 'high';
      if (saved.spacing === true) root.dataset.spacing = 'wide';
      if (saved.motion === true) root.dataset.motion = 'reduced';
    </script>
  </head>
  <body>
    <!--
      THESIS: Entre Laços as a literary magazine held together by its own pink thread: the logo's "laço" runs through the masthead, sections join with a running stitch, the page ends in a knot. Refuses the hero-with-button landing and the card grid.
      OWN-WORLD: wine bookcloth fields, the logo's pink as thread and highlighter, light-pink endpaper; Piazzolla (display and reading) with Archivo for bylines; books as objects with real shadows; no cards, no pills, editorial links.
      STORY: the reader meets a publication, opens its newest review, scans the table of contents, reads a highlighted passage, meets the students who write.
      FIRST VIEWPORT: masthead wordmark at display scale with the thread woven through, description and nav; the newest review's book large on a wine field below, title and byline beside it; "Ler a resenha" link.
      FORM: independent literary magazine (brief-pinned, beats the roll; own list #1), raised by coptic exposed binding (structure as the only ornament) and patent sheet (one ink, one meaning). Seed 823439ef.
      FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
    -->
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <header class:list={['site-header', { masthead }]}>
      <div class="container header-inner">
        {
          masthead ? (
            <>
              <h1 class="wordmark-block">
                <span class="wordmark">
                  <svg class="thread thread-under" viewBox="0 0 1000 200" preserveAspectRatio="none" aria-hidden="true">
                    <path d={THREAD_PATH} pathLength="100" />
                  </svg>
                  {SITE.name}
                  <svg class="thread thread-over" viewBox="0 0 1000 200" preserveAspectRatio="none" aria-hidden="true">
                    <path d={THREAD_PATH} pathLength="100" />
                  </svg>
                  <svg
                    class="thread-knot"
                    viewBox={`0 0 ${KNOT.width} ${KNOT.height}`}
                    style={knotVars}
                    aria-hidden="true"
                  >
                    <path d={KNOT.path} pathLength="1" />
                  </svg>
                </span>
              </h1>
              <p class="masthead-line">{SITE.description}</p>
            </>
          ) : (
            <a class="brand" href={href('')}>
              {SITE.name}
            </a>
          )
        }
        <nav aria-label="Principal" class="site-nav">
          <ul>
            {
              NAV.map((item) => {
                const current = isCurrent(item.path);
                return (
                  <li>
                    <a href={href(item.path)} aria-current={current ? 'page' : undefined}>
                      {item.label}
                      {current && <span class="nav-mark" aria-hidden="true" />}
                    </a>
                  </li>
                );
              })
            }
          </ul>
        </nav>
        {/* Reading settings, in the header so the button never covers the text
            being read. The native Popover API opens and closes the panel (Esc,
            tapping outside, focus back to the button); the script below only
            applies and saves the settings. The panel follows the button in the
            DOM, so Tab moves straight into it. */}
        {/* The name starts with the visible "Aa", so voice control users can say it (WCAG 2.5.3). */}
        <button class="reading-button" type="button" popovertarget="leitura" aria-label="Aa, ajustes de leitura">
          <span class="reading-mark" aria-hidden="true">Aa</span>
        </button>
        <div id="leitura" class="reading-panel" popover role="dialog" aria-labelledby="leitura-titulo">
          <div class="panel-head">
            <h2 id="leitura-titulo">Leitura</h2>
            <button class="panel-link" type="button" popovertarget="leitura" popovertargetaction="hide">
              Fechar
            </button>
          </div>
          <p class="panel-note">Para ler com mais conforto. Vale para todo o site e fica salvo neste navegador.</p>

          <div class="setting" role="group" aria-labelledby="leitura-tamanho">
            <span id="leitura-tamanho" class="setting-name">Tamanho do texto</span>
            <div class="stepper">
              <button type="button" class="step" data-step="-1" aria-label="Diminuir o texto" autofocus>
                <span class="step-small" aria-hidden="true">A−</span>
              </button>
              <output class="step-value" aria-live="polite" data-scale-value>100%</output>
              <button type="button" class="step" data-step="1" aria-label="Aumentar o texto">
                <span aria-hidden="true">A+</span>
              </button>
            </div>
          </div>

          <label class="setting check">
            <input type="checkbox" data-setting="contrast" />
            <span class="setting-name">Alto contraste</span>
            <span class="system-note" data-system-note="contrast" hidden>ligado pelo seu sistema</span>
          </label>
          <label class="setting check">
            <input type="checkbox" data-setting="spacing" />
            <span class="setting-name">Mais espaço entre as linhas</span>
          </label>
          <label class="setting check">
            <input type="checkbox" data-setting="motion" />
            <span class="setting-name">Reduzir animações</span>
            <span class="system-note" data-system-note="motion" hidden>ligado pelo seu sistema</span>
          </label>

          <button class="panel-link panel-reset" type="button" data-reset>Restaurar o padrão</button>
        </div>
      </div>
      <Stitch />
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="knot-line" style={knotVars} aria-hidden="true">
        <span class="knot-thread"></span>
        <svg class="knot" viewBox={`0 0 ${KNOT.width} ${KNOT.height}`} aria-hidden="true">
          <path d={KNOT.path} />
        </svg>
      </div>
      <div class="container footer-grid">
        <div class="colophon">
          <h2 class="footer-title">Expediente</h2>
          <p class="footer-statement">
            {SITE.name} é uma publicação independente de estudantes de Psicologia da {SITE.institution}.
          </p>
          <p class="footer-note">
            Conteúdo produzido por estudantes de Psicologia. Este site não oferece atendimento
            psicológico.
          </p>
        </div>
        <nav aria-label="Rodapé" class="footer-nav">
          <ul>
            {
              NAV.filter((item) => item.path !== '').map((item) => (
                <li>
                  <a href={href(item.path)}>{item.label}</a>
                </li>
              ))
            }
            <li>
              <a href={instagramUrl(SITE.instagram)} rel="noopener noreferrer" target="_blank">
                Instagram @{SITE.instagram}<span class="visually-hidden"> (abre em nova aba)</span>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </footer>

  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    padding: 0.5rem 1rem;
    background: var(--color-wine);
    color: var(--color-on-wine);
    font-family: var(--font-sans);
    z-index: 10;
  }
  .skip-link:focus {
    top: 1rem;
  }

  /* ---- Running head (inner pages) ---- */
  /* Phones: name and the reading button on one row, the nav below.
     Wider: name, nav and button on one row. DOM order (name, nav, button,
     panel) is the reading and Tab order in both. */
  .header-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'brand settings'
      'nav nav';
    align-items: center;
    gap: 0.25rem 1rem;
    padding-block: 0.75rem;
  }
  .brand {
    grid-area: brand;
  }
  .site-nav {
    grid-area: nav;
  }
  .reading-button {
    grid-area: settings;
  }
  @media (min-width: 48rem) {
    .header-inner {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas: 'brand nav settings';
      column-gap: 1.5rem;
    }
    .site-nav {
      justify-self: end;
    }
  }
  .brand {
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-wine);
    text-decoration: none;
  }
  .brand:hover {
    color: var(--color-wine-deep);
  }

  /* ---- Masthead (home) ---- */
  /* Phones: the name, then the description with the reading button beside
     it, then the nav. Wider: name and description, then nav and button. */
  .masthead .header-inner {
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'word word'
      'line settings'
      'nav nav';
    align-items: start;
    gap: 1rem;
    padding-block: clamp(1.25rem, 3.5vw, 2.5rem) 0.25rem;
  }
  .wordmark-block {
    grid-area: word;
  }
  .masthead-line {
    grid-area: line;
  }
  .wordmark-block {
    margin: 0;
    /* The word plus its knot measure about 5.9em: sized so they always fit
       the column, and a phone never scrolls sideways. */
    /* No lower bound in rem: with a larger text setting it would push the
       word and its knot past the edge of a phone. */
    font-size: min(calc((100vw - 2 * var(--gutter)) / 5.9), 9.75rem);
    font-weight: 500;
    line-height: 0.9;
    letter-spacing: -0.035em;
    color: var(--color-ink);
  }
  .wordmark {
    position: relative;
    display: inline-block;
    isolation: isolate;
    padding-bottom: 0.08em;
    /* Room for the knot (it starts 4% past the word and is 0.95em wide),
       so it never runs into the description. */
    margin-right: 1.15em;
  }
  .thread {
    position: absolute;
    left: -5%;
    top: 0;
    width: 109%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .thread path,
  .thread-knot path {
    fill: none;
    stroke: var(--color-thread);
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* The thread's box is stretched (preserveAspectRatio none), so its stroke
     is kept in screen space. */
  .thread path {
    stroke-width: 0.02em;
    vector-effect: non-scaling-stroke;
  }
  /* The knot scales uniformly instead, and must: its draw-on dash is
     measured in its own units. 0.95em spans --knot-units, so this width
     equals the thread's 0.02em at any size. */
  .thread-knot path {
    stroke-width: calc(var(--knot-units) * 0.02px / 0.95);
  }
  /* The footer's knot, tied where the masthead's thread ends. */
  .thread-knot {
    position: absolute;
    /* The thread's drawing ends at -5% + 109% of the word, at y = 96 of
       200 (48%); the knot's entry sits on that point. */
    left: 104%;
    top: calc(48% - 0.95em * var(--knot-entry));
    width: 0.95em;
    aspect-ratio: var(--knot-aspect);
    overflow: visible;
    pointer-events: none;
  }
  .thread-under {
    z-index: -1;
  }
  /* Dashes of the front copy are where the thread crosses over the strokes. */
  .thread-over path {
    stroke-dasharray: 7 6 9 5 6 7 10 6 8 5;
  }
  .masthead-line {
    max-width: 26rem;
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
  @media (min-width: 56rem) {
    .masthead .header-inner {
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas:
        'word line line'
        'nav nav settings';
      align-items: end;
      /* The knot already separates the name from the description. */
      column-gap: clamp(1.25rem, 2.5vw, 2.25rem);
    }
    .masthead-line {
      margin-bottom: 1.1em;
    }
    .masthead .reading-button {
      align-self: center;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .thread {
      animation: pull-thread 1.1s var(--ease-out) 0.15s backwards;
    }
    /* Once the thread is through the name, it ties itself in one stroke:
       it starts as slowly as the thread arrives, speeds through the lobes
       and settles at the tail. */
    .thread-knot path {
      stroke-dasharray: 1;
      animation: tie-knot 1.1s cubic-bezier(0.45, 0, 0.25, 1) 1s backwards;
    }
  }
  @keyframes pull-thread {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  /* Hidden until its own turn: a dash pattern alone leaves round-cap
     specks where the dashes meet the path's ends. */
  @keyframes tie-knot {
    from {
      stroke-dashoffset: 1;
      opacity: 0;
    }
    1% {
      opacity: 1;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  /* ---- Navigation ---- */
  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 clamp(1rem, 3vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-nav a {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-sans);
    font-size: 1rem;
    color: var(--color-ink);
    text-decoration: none;
  }
  /* Hover draws a hairline from the left. */
  .site-nav a::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 0.45rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
  }
  /* The current page is marked as a reader marks a book: highlighter. */
  .nav-mark {
    position: absolute;
    z-index: -1;
    inset-inline: -0.2em;
    top: calc(50% - 0.12em);
    height: 0.55em;
    border-radius: var(--radius-book);
    background: var(--color-rose);
    mix-blend-mode: multiply;
  }
  @media (hover: hover) {
    .site-nav a:hover {
      color: var(--color-wine);
    }
    .site-nav a:not([aria-current]):hover::after {
      transform: scaleX(1);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .site-nav a::after {
      transition: transform var(--duration-base) var(--ease-out);
    }
    .nav-mark {
      view-transition-name: nav-mark;
    }
  }

  /* ---- Expediente ---- */
  .site-footer {
    margin-top: clamp(4rem, 10vw, 7rem);
    padding-bottom: 3rem;
    background: var(--color-wine);
    color: var(--color-on-wine);
  }
  /* The thread that ran through the masthead ends here, tied. */
  /* Thread from the left edge of the screen, knot at the content's right
     edge (the right padding equals the container's side margin). */
  .knot-line {
    display: flex;
    align-items: flex-start;
    padding-top: 1.5rem;
    padding-right: calc((100% - min(100% - 2 * var(--gutter), var(--content-width))) / 2);
  }
  /* Sits on the knot's entry line. */
  .knot-thread {
    flex: 1;
    height: 2.5px;
    margin-top: calc(7rem * var(--knot-entry) - 1.25px);
    background: var(--color-thread);
  }
  .knot {
    flex: none;
    width: 7rem;
    aspect-ratio: var(--knot-aspect);
    overflow: visible;
  }
  .knot path {
    fill: none;
    stroke: var(--color-thread);
    stroke-width: 2.5px;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .footer-grid {
    display: grid;
    gap: 2.5rem 4rem;
    padding-top: 2rem;
  }
  @media (min-width: 48rem) {
    .footer-grid {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }
  }
  .footer-title {
    margin: 0 0 0.75rem;
    font-size: 1.75rem;
  }
  .footer-statement {
    max-width: 30rem;
    margin: 0 0 1.25rem;
    font-size: clamp(1.125rem, 2vw, 1.3125rem);
    line-height: 1.4;
  }
  .footer-note {
    max-width: 30rem;
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-on-wine-muted);
  }
  .footer-nav ul {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-sans);
    color: var(--color-on-wine);
  }
  /* The global wine ring disappears on the wine footer. */
  .site-footer a:focus-visible {
    outline-color: var(--color-rose);
  }

  /* ---- Reading settings ---- */

  /* A 44px target around a smaller mark in the logo's grammar: a wine circle
     with light serif letters. */
  .reading-button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
  }
  .reading-mark {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-wine);
    color: var(--color-on-wine);
    font: 500 1rem/1 var(--font-serif);
    letter-spacing: -0.02em;
    transition: background-color var(--duration-fast) ease;
  }
  /* Darker while hovered or while its panel (the next element) is open. */
  .reading-button:hover .reading-mark,
  .reading-button:has(+ .reading-panel:popover-open) .reading-mark {
    background: var(--color-wine-deep);
  }

  /* A wine field, square like every field; the thin light edge separates
     it from the wine footer when the panel opens over it. */
  .reading-panel {
    position: fixed;
    inset: auto;
    top: max(0.75rem, env(safe-area-inset-top));
    right: max(0.75rem, env(safe-area-inset-right));
    width: min(21rem, 100vw - 1.5rem);
    max-height: calc(100dvh - 1.5rem);
    margin: 0;
    padding: 1.25rem 1.25rem 0.75rem;
    overflow: auto;
    border: 1px solid var(--color-on-wine-muted);
    background: var(--color-wine);
    color: var(--color-on-wine);
    accent-color: var(--color-rose);
  }
  .reading-panel :focus-visible {
    outline-color: var(--color-on-wine);
  }
  .panel-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .panel-head h2 {
    margin: 0;
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
  }
  .panel-note {
    margin: 0.25rem 0 0.75rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-on-wine-muted);
  }
  .setting {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 0.75rem;
    min-height: 44px;
    border-top: 1px solid rgb(244 174 189 / 0.35);
    font-family: var(--font-sans);
    font-size: 1rem;
  }
  /* Box and words side by side; long labels (large text) wrap beside the
     box, never under it. */
  .setting.check {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.75rem;
    padding-block: 0.5rem;
    cursor: pointer;
  }
  .setting input {
    width: 1.25rem;
    height: 1.25rem;
    margin: 0;
    cursor: pointer;
  }
  .setting input:disabled {
    cursor: not-allowed;
  }
  .system-note {
    grid-column: 2;
    font-size: 0.875rem;
    color: var(--color-on-wine-muted);
  }
  .stepper {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .step {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid var(--color-on-wine-muted);
    background: transparent;
    color: var(--color-on-wine);
    font: 500 1.125rem/1 var(--font-serif);
    cursor: pointer;
  }
  .step-small {
    font-size: 0.8em;
  }
  /* aria-disabled, not disabled: a disabled button would drop the reader's
     focus the moment it reaches the end of the scale. */
  .step[aria-disabled='true'] {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .step-value {
    min-width: 3.25rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .panel-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-on-wine);
    font-family: var(--font-sans);
    font-size: 1rem;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 40%, transparent);
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .panel-link:hover {
    text-decoration-color: currentColor;
  }
  .panel-reset {
    margin-top: 0.25rem;
  }
  .panel-reset[aria-disabled='true'] {
    opacity: 0.6;
    text-decoration: none;
    cursor: default;
  }
</style>

<script>
  /*
   * The reading panel's controls. Settings are applied as attributes and a
   * custom property on <html> (styles in global.css), saved to localStorage,
   * and the controls mirror them. The system's own preferences (less motion,
   * more contrast) win and show as switched on and locked.
   */
  import {
    DEFAULTS,
    STORAGE_KEY,
    TEXT_SCALES,
    isDefault,
    parseSettings,
    scaleLabel,
    stepScale,
    type ReadingSettings,
  } from '../lib/reading-settings.ts';

  const panel = document.getElementById('leitura');

  if (panel) {
    const root = document.documentElement;
    const systemMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const systemContrast = matchMedia('(prefers-contrast: more)');
    const value = panel.querySelector<HTMLOutputElement>('[data-scale-value]')!;
    const steps = [...panel.querySelectorAll<HTMLButtonElement>('[data-step]')];
    const reset = panel.querySelector<HTMLButtonElement>('[data-reset]')!;
    const box = (name: 'contrast' | 'spacing' | 'motion') =>
      panel.querySelector<HTMLInputElement>(`[data-setting="${name}"]`)!;
    const note = (name: 'contrast' | 'motion') =>
      panel.querySelector<HTMLElement>(`[data-system-note="${name}"]`)!;

    let settings: ReadingSettings = load();

    function load(): ReadingSettings {
      try {
        return parseSettings(localStorage.getItem(STORAGE_KEY));
      } catch {
        // Storage blocked: settings still work, for this page only.
        return { ...DEFAULTS };
      }
    }

    function save() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(settings));
      } catch {
        // Storage blocked: the change applies to this page and isn't kept.
      }
    }

    function setFlag(name: string, on: boolean, value: string) {
      if (on) root.dataset[name] = value;
      else delete root.dataset[name];
    }

    function apply() {
      const scale = TEXT_SCALES[settings.scale] ?? 1;
      if (scale === 1) root.style.removeProperty('--text-scale');
      else root.style.setProperty('--text-scale', String(scale));
      setFlag('contrast', settings.contrast || systemContrast.matches, 'high');
      setFlag('spacing', settings.spacing, 'wide');
      setFlag('motion', settings.motion, 'reduced');
      render();
    }

    function render() {
      value.textContent = scaleLabel(settings.scale);
      steps.forEach((button) => {
        const atEnd =
          Number(button.dataset.step) < 0
            ? settings.scale === 0
            : settings.scale === TEXT_SCALES.length - 1;
        button.setAttribute('aria-disabled', String(atEnd));
      });
      for (const [name, system] of [
        ['contrast', systemContrast],
        ['motion', systemMotion],
      ] as const) {
        box(name).checked = settings[name] || system.matches;
        box(name).disabled = system.matches;
        note(name).hidden = !system.matches;
      }
      box('spacing').checked = settings.spacing;
      reset.setAttribute('aria-disabled', String(isDefault(settings)));
    }

    function update(next: ReadingSettings) {
      settings = next;
      save();
      apply();
    }

    steps.forEach((button) =>
      button.addEventListener('click', () => {
        if (button.getAttribute('aria-disabled') === 'true') return;
        update(stepScale(settings, Number(button.dataset.step) as 1 | -1));
      }),
    );
    (['contrast', 'spacing', 'motion'] as const).forEach((name) =>
      box(name).addEventListener('change', () => update({ ...settings, [name]: box(name).checked })),
    );
    reset.addEventListener('click', () => {
      if (reset.getAttribute('aria-disabled') === 'true') return;
      update({ ...DEFAULTS });
    });
    systemMotion.addEventListener('change', render);
    systemContrast.addEventListener('change', apply);

    render();
  }
</script>
