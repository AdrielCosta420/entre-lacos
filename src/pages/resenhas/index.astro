---
import ReviewEntry from '../../components/ReviewEntry.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { groupByCategory } from '../../lib/categories.ts';
import { getPublishedReviews, withAuthors } from '../../lib/content.ts';
import { plural } from '../../lib/plural.ts';
import { SITE } from '../../lib/site.ts';

// The archive is read like a magazine's sections: one per category, reached
// from the index at the top. Inside each, newest first.
const entries = await withAuthors(await getPublishedReviews());
const sections = groupByCategory(entries, (entry) => entry.review.data.category);
---

<BaseLayout
  title="Resenhas"
  description={`Todas as resenhas de livros do ${SITE.name}, escritas sob o olhar da Psicologia.`}
>
  <header class="container page-head">
    <h1>Resenhas</h1>
    {
      entries.length > 0 ? (
        <>
          <p class="standfirst">
            {plural(entries.length, 'resenha', 'resenhas')} escritas por estudantes de Psicologia da{' '}
            {SITE.institution}, organizadas por categoria.
          </p>
          <nav class="index" aria-label="Categorias">
            <ul>
              {sections.map((section) => (
                <li>
                  <a href={`#${section.anchor}`}>{section.category}</a>
                  <span class="count">{section.reviews.length}</span>
                </li>
              ))}
            </ul>
          </nav>
        </>
      ) : (
        <p class="standfirst">As primeiras resenhas chegam em breve.</p>
      )
    }
  </header>

  {
    sections.map((section) => (
      <section class="section container" id={section.anchor} aria-labelledby={`${section.anchor}-titulo`}>
        <div class="stitch" aria-hidden="true" />
        <div class="with-side">
          <div class="side">
            <h2 id={`${section.anchor}-titulo`}>{section.category}</h2>
            <p class="meta">{plural(section.reviews.length, 'resenha', 'resenhas')}</p>
          </div>
          <ol class="entries">
            {section.reviews.map(({ review, author }) => (
              <ReviewEntry review={review} author={author} showCategory={false} />
            ))}
          </ol>
        </div>
      </section>
    ))
  }
</BaseLayout>

<style>
  /* The index: section names set as a line of type, each with its count. */
  .index {
    margin-top: 2rem;
  }
  .index ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .index li {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
  }
  .index a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: clamp(1.375rem, 2.4vw, 1.875rem);
    letter-spacing: -0.01em;
  }
  .count {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
  }

  .section {
    scroll-margin-top: 1rem;
    padding-top: clamp(1rem, 3vw, 2rem);
  }
  .section + .section {
    margin-top: clamp(2.5rem, 6vw, 4rem);
  }
  .section .stitch {
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }
</style>
